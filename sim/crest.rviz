Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 10
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
  - Class: rviz_default_plugins/Map
    Name: Navigation map
    Enabled: true
    Topic:
      Value: /fused_map
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Path
    Name: Accepted path
    Enabled: true
    Topic:
      Value: /plan
    Color: 0; 170; 255
    Line Style: Lines
    Line Width: 0.03
  - Class: rviz_default_plugins/MarkerArray
    Name: Accepted six events
    Enabled: true
    Marker Topic:
      Value: /hole_execution_markers
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/RobotModel
    Name: Lift swerve robot
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
  - Class: rviz_default_plugins/Axes
    Name: Chassiss heading
    Enabled: true
    Reference Frame: chassiss
    Length: 0.4
    Radius: 0.015
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.5
      Pitch: 1.15
      Yaw: 0.0
      Focal Point:
        X: 4.694
        Y: 6.35
        Z: 0.0
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetGoal
    Topic: /goal_pose
