<?xml version="1.0"?>
<package format="3">
  <name>nav_bringup</name>
  <version>0.1.0</version>
  <description>导航系统启动配置</description>
  <maintainer email="lehan@todo.todo">lehan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav_components</exec_depend>
  <exec_depend>nav_interfaces</exec_depend>
  <exec_depend>fake_vel_transform</exec_depend>
  <exec_depend>localization_initializer</exec_depend>
  <exec_depend>map_edit</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robots_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>rcl_interfaces</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
