    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>chassis</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/wheel/odometry</odom_topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>lift_joint</joint_name>
      <topic>/lift/position</topic>
      <p_gain>3000</p_gain>
      <i_gain>0</i_gain>
      <d_gain>70</d_gain>
      <cmd_max>300</cmd_max>
      <cmd_min>-300</cmd_min>
      <initial_position>0.3</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>gimbal_yaw_joint</joint_name>
      <topic>/gimbal/cmd_vel</topic>
      <use_force_commands>false</use_force_commands>
      <p_gain>0.2</p_gain>
      <i_gain>0.01</i_gain>
    </plugin>
    <plugin filename="/home/dengjiaxi/simulation_seu/navigatiosim2/install/seu_sentry_sim_control/lib/libsentry_motor_controller.so" name="seu_sentry_sim_control::SentryMotorController">
      <wheel_kp>1.0</wheel_kp>
      <wheel_ki>0.08</wheel_ki>
      <wheel_kd>5e-06</wheel_kd>
      <steer_kp>12</steer_kp>
      <steer_ki>0.15</steer_ki>
      <steer_kd>0.12</steer_kd>
      <wheel_torque_limit>2</wheel_torque_limit>
      <steer_torque_limit>5</steer_torque_limit>
      <integral_limit>1</integral_limit>
      <command_timeout>0.2</command_timeout>
    </plugin>
